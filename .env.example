# Copy to ~/.local/share/shreyadesk/shreyadesk.env (or SHREYADESK_ENV_FILE).
# Keep mode 600. Never commit actual values.
FRONTEND_ORIGIN=http://localhost:5173
KITE_API_KEY=replace-with-new-key
KITE_API_SECRET=replace-with-new-secret
SHREYADESK_USERNAME=replace-with-admin-name
SHREYADESK_PASSWORD_HASH=replace-with-generated-hash
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMAND_USER_ID=
AZURE_VM_NAME=
AZURE_RESOURCE_GROUP=
AZURE_SUBSCRIPTION_ID=
